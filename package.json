{
  "name": "commonkit",
  "private": true,
  "version": "0.1.0",
  "description": "Shared things that pay for their own upkeep \u2014 and open up to the people who keep them alive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:contracts": "bash scripts/build-contracts.sh",
    "test:contracts": "pnpm test:contracts:unit && pnpm test:contracts:int",
    "test:contracts:unit": "cargo test --manifest-path contracts/Cargo.toml --workspace --exclude commonkit-integration-tests",
    "test:contracts:int": "pnpm build:contracts && cargo test --manifest-path contracts/Cargo.toml -p commonkit-integration-tests",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "validate:profiles": "pnpm --filter @commonkit/scripts exec tsx validate-profiles.ts",
    "setup:testnet": "pnpm --filter @commonkit/scripts exec tsx setup-testnet.ts",
    "seed:testnet": "pnpm --filter @commonkit/scripts exec tsx seed-testnet.ts",
    "demo:step": "pnpm --filter @commonkit/scripts exec tsx demo/run.ts",
    "demo:all": "pnpm --filter @commonkit/scripts exec tsx demo/run.ts all",
    "trezu:engine": "pnpm --filter @commonkit/scripts trezu:engine",
    "trezu:test": "pnpm --filter @commonkit/scripts trezu:engine && pnpm --filter @commonkit/scripts exec vitest run trezu",
    "trezu:file": "pnpm --filter @commonkit/scripts trezu:file",
    "build:site": "bash scripts/build-site.sh",
    "serve:site": "node scripts/serve-site.mjs",
    "dev:web": "pnpm --filter @commonkit/web dev",
    "dev:bridge": "pnpm --filter @commonkit/bridge dev",
    "device:add": "pnpm --filter @commonkit/bridge device:add",
    "dev:agent": "pnpm --filter @commonkit/agent dev",
    "simulate": "bash scripts/simulate.sh",
    "test:simulate": "SIMULATE_SANDBOX=1 pnpm --filter @commonkit/scripts test -- simulate",
    "video:build": "bash scripts/video/build.sh"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
