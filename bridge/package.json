{
  "name": "@commonkit/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "COMMONKIT bridge: NEP-413 access checks, device adapters, sessions, telemetry and verification reporting",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --config config.sim.yaml",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:vectors": "tsx test/gen-nep413-vectors.ts",
    "emulate": "tsx src/emulators/cli.ts",
    "dev:emulated": "tsx src/emulated-stack.ts",
    "device:add": "tsx src/cli/device-add.ts",
    "washer-loop": "tsx scripts/washer-loop.ts"
  },
  "dependencies": {
    "@commonkit/sdk": "workspace:*",
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "@scure/base": "2.4.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/curves": "2.4.0",
    "@types/node": "24.19.2",
    "borsh": "2.0.0",
    "eslint": "10.14.0",
    "near-api-js": "7.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
