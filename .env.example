# Copy to .env (gitignored). Never commit real keys.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ROOT_ACCOUNT_ID=commonkit-sxflo.testnet
# Chain-ops scripts read keys from the NEAR CLI legacy keychain, never from this file:
#   ~/.near-credentials/testnet/<account>.json and <account>/ed25519_<pk>.json
# Override the keychain location only for tests:
NEAR_CREDENTIALS_DIR=
# Function-call keys (restricted to asset contracts + methods). setup-testnet.ts adds one key per
# (operator, asset) and stores it in the keychain; deployments/testnet.json `function_call_keys`
# lists each public key with its receiver and method names.
BRIDGE_ACCOUNT_ID=
BRIDGE_PRIVATE_KEY=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Optional: NEAR AI Cloud (agent rationale rephrasing only)
NEARAI_API_KEY=
NEARAI_BASE_URL=
NEARAI_MODEL=
