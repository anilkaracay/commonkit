{
  "name": "@commonkit/design",
  "private": true,
  "version": "0.1.0",
  "description": "COMMONKIT design system (D-030): light-led blue tokens, CK Sans + Geist Mono, Tailwind v4 theme, base components.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./components.css": "./components.css",
    "./tailwind.css": "./tailwind.css",
    "./all.css": "./all.css",
    "./fonts/*": "./fonts/*",
    "./posters/*": "./posters/*",
    "./react": "./src/react.ts",
    "./assets/*": "./assets/*",
    "./near": "./src/near.ts",
    "./logo": "./src/logo.ts",
    "./logo/*": "./logo/*"
  },
  "files": [
    "*.css",
    "README.md",
    "assets",
    "logo",
    "fonts",
    "posters",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
