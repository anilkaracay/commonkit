  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.187.0",
    "playwright": "1.64.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
